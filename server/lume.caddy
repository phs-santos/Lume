# Lume — caixa de entrada de ideias (contêiner em /root/lume/server)
lume.codexolimpo.com {
	encode gzip

	# nenhuma ideia passa de 25 MB; recusa antes de chegar ao Node
	request_body {
		max_size 26MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy 127.0.0.1:3020
}
